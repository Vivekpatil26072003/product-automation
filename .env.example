# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
# Runtime connection uses the non-privileged role so RLS applies.
DATABASE_URL=postgresql+psycopg://prod_app:prod_app_dev@localhost:5433/production
# Migrations and seeding use the owner role.
DATABASE_OWNER_URL=postgresql+psycopg://prod_owner:prod_owner_dev@localhost:5433/production
REDIS_URL=redis://localhost:6380/0

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=prodauto-local
STORAGE_ACCESS_KEY_ID=prodauto
STORAGE_SECRET_ACCESS_KEY=prodauto-dev-secret
STORAGE_REGION=us-east-1
STORAGE_CORS_ORIGINS=["http://localhost:3000"]

# Malware scanning (ClamAV clamd from infra/local). "disabled" is refused outside development/test.
MALWARE_SCANNER=clamav
CLAMD_HOST=localhost
CLAMD_PORT=3310

# OCR for scans/photos: none | claude | azure. "none" makes such pages fail visibly with OCR_NOT_CONFIGURED.
# Handwritten order notes need a reader: "azure" = Azure AI Document Intelligence, free F0 tier (500 pages/month),
# set up as in docs/runbooks/customer-orders.md. Put the endpoint and key in .env only (see below), never in code.
OCR_PROVIDER=none

# AI reading: none | claude. With claude, diary pages are structured into customer orders by Claude (app/orders/ai.py)
# and free-form production notes into production entries. See docs/runbooks/diary-automation.md.
# AI extraction for notes the table/labelled-line extractors cannot read: none | claude.
# Requires ANTHROPIC_API_KEY in the environment (never commit it) and data-processing approval (D6).
AI_PROVIDER=none
ANTHROPIC_MODEL=claude-opus-5-5
# Report summary: "template" (default, deterministic) or "claude" (checked paraphrase, falls back to template).
NARRATIVE_PROVIDER=template
# ANTHROPIC_API_KEY=<from secret store>
# OCR_PROVIDER=gemini                 # photos read by Google Gemini (free key: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=<paste your key here, never in chat or git>
# GEMINI_MODEL=gemini-3.1-flash-lite   # answered in 10-15 s with 98% right on real registers (Oct 2026)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# OCR_PROVIDER=azure
# AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DI_KEY=<from secret store>

# Company SSO (OIDC). For local testing: docker compose --profile oidc up -d
OIDC_ISSUER=http://localhost:8090/default
OIDC_CLIENT_ID=production-automation-local
OIDC_CLIENT_SECRET=local-dev-only
PUBLIC_BASE_URL=http://localhost:8000

# Server-side secret for CSRF/HMAC derivation. Generate a long random value per environment.
SESSION_SECRET=change-me-local-development-only-0123456789
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Development-only sign-in shortcut for seeded memberships. Refused outside development/test.
DEV_AUTH_ENABLED=true

# Encryption key ring for integration credentials ("id:base64(32 bytes)", first one encrypts).
# DEVELOPMENT VALUE ONLY. Generate per environment: python -c "from app.core.crypto import new_key; print(new_key())"
INTEGRATION_KEYS=dev1:2LVkgM5xfI7jBUDE8SYpx7JeljepKdLqaQOxmK4CB8E=

# Report email channel: "emailjs" (the Sender's browser sends through EmailJS, see docs/runbooks/emailjs.md)
# or "graph" (the server sends through the connected Microsoft 365 mailbox). Automatic sending needs "graph".
EMAIL_PROVIDER=emailjs

# EmailJS account for server-side sends (Send Email on orders, owner reports). Backend only: read by the API and
# the worker; never put these in apps/web, and never commit real values. From the EmailJS dashboard:
# Email Services (service ID), Email Templates (template ID), Account -> General (public and private key).
# EmailJS Account -> Security must allow API requests for non-browser applications.
# Values set here take precedence over Settings -> Owner report & email and are shown there read-only.
# Leave empty until you fill them in .env (empty = not configured; sending is refused with a clear message).
# Format: EMAILJS_SERVICE_ID=service_xxxxxxx, EMAILJS_TEMPLATE_ID=template_xxxxxxx.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Operations (M8). Hold every outbound email in the queue (incident / restore drill). Nothing is dropped.
SENDS_PAUSED=false
# Token for GET /api/v1/ops/metrics (Prometheus). Unset = endpoint not exposed.
# METRICS_TOKEN=
