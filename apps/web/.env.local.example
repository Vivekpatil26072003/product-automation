# Copy to .env.local. The API is reached through the /api rewrite in next.config.mjs.
BACKEND_URL=http://127.0.0.1:8000
# Shows the development-only sign-in picker. Must be false (or absent) outside development.
NEXT_PUBLIC_DEV_AUTH=true
# EmailJS (used when the API runs with EMAIL_PROVIDER=emailjs). Public values only: never put the EmailJS
# private key here. Service ID from EmailJS > Email Services, template ID from Email Templates, public key from
# Account > General. Restart `npm run dev` after changing them.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_75drj1q
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
